# Variables usadas por docker compose en la raíz del monorepo.
# Secretos del API van en Beacon-Backend/.env

DB_USER=beacon
DB_PASSWORD=<your_postgres_password>
DB_NAME=beacon
DB_PORT=5433

DB_SYNC=true
# Note: true en local con Docker. En Railway usar false cuando haya migraciones.

FRONTEND_URL=http://localhost:5173
# Note: Origen del frontend en el navegador (CORS). Puerto 5173 del compose.

REFRESH_COOKIE_SECURE=false
# Note: false en HTTP local. true en HTTPS (Vercel + Railway).

VITE_BACK_URL=http://localhost:3000
# Note: URL del API vista desde el navegador. En Docker local: http://localhost:3000

# Make sure to keep the .env file private and do not share it publicly.
